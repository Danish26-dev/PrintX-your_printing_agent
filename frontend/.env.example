# PrintX Frontend configuration (Create React App convention)
#
# NOTE: CRA inlines REACT_APP_* at BUILD time. For Cloud Run, pass these as
# docker build --build-arg values (see frontend/Dockerfile), not at runtime.

# Base URL of the PrintX Backend API (the application control plane).
# The frontend talks ONLY to the Backend — never directly to the Strands Agent,
# the Document Engine, or AWS.
REACT_APP_API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Firebase Web App config (shopkeeper Google Sign-In).
# These are PUBLIC client identifiers (not secrets) — safe to ship in the
# bundle. Get them from Firebase console > Project settings > Your apps > Web.
# When ALL of API_KEY + AUTH_DOMAIN + PROJECT_ID are present, the shopkeeper
# login requires Google Sign-In; otherwise it falls back to the local mock.
# ---------------------------------------------------------------------------
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=printx-506807.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=printx-506807
REACT_APP_FIREBASE_APP_ID=

# Shared-token fallback for shopkeeper calls (only when the backend uses
# AUTH_MODE=token). Leave empty when using Firebase.
REACT_APP_SHOPKEEPER_API_TOKEN=
