# PrintX Backend (application control plane) configuration

# Port this Backend listens on
PORT=3001

# URL of the Strands Agent service (owns Bedrock + tools + planning)
STRANDS_AGENT_URL=http://localhost:4000

# URL of the Python Document Engine (owns conversion + deterministic editing).
# The Backend uses this ONLY to proxy preview/download of processed files.
DOCUMENT_ENGINE_URL=http://localhost:5001

# Where the Backend keeps its own temporary job files (originals + copies of output).
STORAGE_DIR=./_storage

# Limits / safety
MAX_UPLOAD_BYTES=52428800        # 50 MB
MAX_INSTRUCTION_LENGTH=2000
MAX_COPIES=999

# Timeouts (ms) for calls to downstream services
AGENT_TIMEOUT_MS=180000
ENGINE_TIMEOUT_MS=120000

# CORS origin for the frontend (use * for local dev)
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Local Printer Agent (runs on the shopkeeper's computer)
# ---------------------------------------------------------------------------
# URL of the PrintX local printer agent. The Backend cannot drive a local
# printer directly, so it delegates discovery + submission to this agent.
# Leave EMPTY to run without real printing (the Backend then honestly reports
# that no printer is connected and refuses to fake a print).
#   - Backend on the host (local dev):  http://127.0.0.1:7777
#   - Backend in Docker, agent on host: http://host.docker.internal:7777
PRINTER_AGENT_URL=
# Optional shared token the local agent requires (must match the agent's
# PRINTER_AGENT_TOKEN). Leave empty for localhost-only dev.
PRINTER_AGENT_TOKEN=
PRINTER_AGENT_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Shopkeeper authentication / authorization
# ---------------------------------------------------------------------------
# AUTH_MODE selects how shopkeeper-only endpoints (configure-printer,
# submit-print, print, printers/test, /shop/jobs, /shop/overview, DELETE jobs)
# are protected:
#   firebase — verify Firebase ID tokens via the Admin SDK (PRODUCTION).
#   token    — shared x-shopkeeper-token header (CI / simple hosted).
#   none     — guard DISABLED (local dev / tests ONLY; must be set explicitly).
# If unset it is derived: firebase when FIREBASE_PROJECT_ID + SHOPKEEPER_ALLOWLIST
# are set; else token when SHOPKEEPER_API_TOKEN is set; else none.
AUTH_MODE=

# Firebase project for ID-token verification (defaults to GOOGLE_CLOUD_PROJECT).
FIREBASE_PROJECT_ID=
# Comma-separated allowlist of authorized shopkeeper emails (must be verified
# Google accounts). Example: owner@example.com,manager@example.com
SHOPKEEPER_ALLOWLIST=

# Shared-token fallback (AUTH_MODE=token). The frontend sends it from
# REACT_APP_SHOPKEEPER_API_TOKEN. Leave empty when using Firebase.
SHOPKEEPER_API_TOKEN=

# ---------------------------------------------------------------------------
# Durable persistence (Cloud Run). Defaults keep local dev on memory + disk.
# ---------------------------------------------------------------------------
# JOB_STORE: 'memory' (default; dev/tests) | 'firestore' (durable job metadata).
JOB_STORE=memory
# Firestore collection for jobs (when JOB_STORE=firestore).
FIRESTORE_COLLECTION=jobs
# STORAGE_BACKEND: 'local' (default; dev/tests) | 'gcs' (private Cloud Storage).
STORAGE_BACKEND=local
# GCS bucket for documents (required when STORAGE_BACKEND=gcs). Must be PRIVATE.
GCS_BUCKET=
# Google Cloud project id (Firestore/GCS/Firebase Admin). On Cloud Run this is
# usually inferred from the service identity (ADC); set it to be explicit.
GOOGLE_CLOUD_PROJECT=
