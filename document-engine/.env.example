# Python Document Engine configuration

# Port the FastAPI service listens on
PORT=5001

# Directory for temporary working files (uploads, converted, edited)
WORK_DIR=./_work

# Path to the LibreOffice "soffice" binary used for DOCX -> PDF conversion.
# On the Docker image this is /usr/bin/soffice.
# On Windows dev it is typically:
#   C:\Program Files\LibreOffice\program\soffice.exe
# Leave blank to auto-detect from PATH / common locations.
SOFFICE_PATH=

# How long (seconds) a single LibreOffice conversion is allowed to run.
CONVERT_TIMEOUT=120
