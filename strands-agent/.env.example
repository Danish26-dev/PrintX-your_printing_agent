# PrintX Strands Agent — example environment configuration.
# Copy this file to ".env" and fill in the values. NEVER commit the real .env.

# Port the agent HTTP service listens on
PORT=4000

# URL of the Python Document Engine (inspect / process / download)
DOCUMENT_ENGINE_URL=http://localhost:5001

# ----------------------------------------------------------------------------
# Google Cloud Vertex AI (ACTIVE model provider) — required
# ----------------------------------------------------------------------------
# Authentication uses Application Default Credentials (ADC). Do NOT set an API
# key and do NOT create a service-account JSON key for local dev. Instead run:
#   gcloud auth application-default login
# Application code never reads credentials; the Google auth library resolves ADC.
GOOGLE_CLOUD_PROJECT=printx-506807
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
VERTEX_AI_MODEL_ID=gemini-2.5-flash

# Sampling temperature for planning. Keep low for deterministic plans.
MODEL_TEMPERATURE=0

# Per-call output token cap (helps limit token-per-minute usage).
VERTEX_MAX_OUTPUT_TOKENS=2048
# Gemini 2.5 "thinking" token budget.
#   -1 (default) = unset: use the model's default budget (keeps tool-calling
#        reliable). RECOMMENDED.
#   A positive value caps thinking tokens. Do NOT set 0 — it can stall the
#        tool-calling loop for gemini-2.5-flash.
VERTEX_THINKING_BUDGET=-1

# ----------------------------------------------------------------------------
# AWS Bedrock (DORMANT — not on the active model path)
# ----------------------------------------------------------------------------
# Kept so the Bedrock provider can be re-enabled later without code changes.
# These are optional and NOT required to start the agent. If you are no longer
# using Bedrock, you can remove them (and deactivate the AWS key in IAM).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
